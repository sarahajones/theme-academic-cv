	langid = {english},
	keywords = {Decision making, Human behaviour, Politics, Social science},
	file = {Full Text PDF:C\:\\Users\\sa4422\\Zotero\\storage\\Q8Q7SF44\\Ruggeri et al. - 2021 - The general fault in our fault lines.pdf:application/pdf},
}

